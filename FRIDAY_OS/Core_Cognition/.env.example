# ==========================================
# FRIDAY MK.1 — ENVIRONMENT TEMPLATE
# ==========================================
#
# Copy this file to `.env` in this same directory and fill in your own values:
#
#     cp FRIDAY_OS/Core_Cognition/.env.example FRIDAY_OS/Core_Cognition/.env
#
# `.env` is listed in .gitignore and must never be committed.
# This template contains placeholders only — no real keys, tokens, or IDs.
#
# ------------------------------------------------------------------
# HOW TO READ THIS FILE
# ------------------------------------------------------------------
# Uncommented entries below are the values FRIDAY needs from you.
# Every commented-out (`#`) entry is optional: leaving it commented keeps the
# default that is compiled into the code, shown as "default: ..." in its
# comment. Uncomment one only when you want to override that default.
#
# LEGACY ALIASES: every FRIDAY_* variable also accepts a JARVIS_* spelling of
# the same name (e.g. JARVIS_USER_NAME for FRIDAY_USER_NAME), kept for older
# installs. FRIDAY_* is checked first and wins. Use FRIDAY_* in new setups.
#
# NOT SET HERE: GRPC_VERBOSITY, GRPC_TRACE and GRPC_POLL_STRATEGY are assigned
# by the code at import time to silence gRPC logging. Do not set them here.


# ==========================================
# 1. REQUIRED CREDENTIALS
# ==========================================

# Google Gemini API key. Powers the main reasoning model, the silent operator
# model, and the Electron live-voice layer. FRIDAY will not start without it.
GEMINI_API_KEY=your_gemini_api_key_here

# Fish Audio API key. Powers FRIDAY's cloud text-to-speech voice.
# Leave blank to fall back to the local macOS system voice.
FISH_API_KEY=your_fish_audio_api_key_here

# Fish Audio voice model reference ID — which voice FRIDAY speaks with.
VOICE_ID=your_fish_voice_id_here


# ==========================================
# 2. FISH AUDIO / TEXT-TO-SPEECH
# ==========================================

# Explicit Fish Audio model ID. Falls back to VOICE_ID when unset.
# FISH_MODEL_ID=your_fish_model_id_here

# Fish Audio text-to-speech endpoint. default: https://api.fish.audio/v1/tts
# FISH_TTS_URL=https://api.fish.audio/v1/tts

# Audio container requested from Fish Audio. default: mp3
# FISH_AUDIO_FORMAT=mp3

# Seconds to wait for a complete synthesis response. default: 12
# FISH_TTS_TIMEOUT=12

# Seconds to wait for the initial connection to Fish Audio. default: 4
# FISH_CONNECT_TIMEOUT=4

# Responses smaller than this many bytes are treated as failed synthesis.
# default: 512
# FISH_MIN_AUDIO_BYTES=512

# Consecutive Fish Audio failures tolerated before backing off to the local
# voice. default: 2
# FISH_FAILURES_BEFORE_BACKOFF=2

# Initial backoff pause, in seconds, after repeated failures. Doubles on each
# further failure. default: 45
# FISH_BACKOFF_START_SECONDS=45

# Upper bound, in seconds, on the doubling backoff pause. default: 300
# FISH_BACKOFF_MAX_SECONDS=300


# ==========================================
# 3. IDENTITY & PERSONALIZATION
# ==========================================

# Name FRIDAY addresses you by in conversation and calendar summaries.
# FRIDAY_USER_NAME=your_name_here

# Name of the face-ID authorized user, matched against the enrolled profile.
# FRIDAY_AUTHORIZED_USER=your_name_here

# Directory holding the enrolled face profile images used by vision_core.
# default: FRIDAY_OS/Data/User_Profiles/<user>
# FRIDAY_PROFILE_DIR=/absolute/path/to/your/profile/directory

# Default city used for weather and location-aware answers.
# FRIDAY_DEFAULT_LOCATION=Your City, ST

# Default latitude for weather lookups, decimal degrees.
# FRIDAY_DEFAULT_LATITUDE=your_latitude_here

# Default longitude for weather lookups, decimal degrees.
# FRIDAY_DEFAULT_LONGITUDE=your_longitude_here


# ==========================================
# 4. MODELS & LOCAL ROUTING
# ==========================================

# Gemini model used for silent/background operator tasks.
# default: gemini-2.5-flash
# FRIDAY_SILENT_MODEL=gemini-2.5-flash

# Ollama generate endpoint for the local fast router. Leave unset to skip local
# routing. default (fast_router): http://localhost:11434/api/generate
# FRIDAY_OLLAMA_URL=http://localhost:11434/api/generate

# Local Ollama model used by the fast router. default: llama3.2:3b
# FRIDAY_OLLAMA_MODEL=llama3.2:3b

# Seconds the fast router waits on Ollama before giving up. default: 1.0
# FRIDAY_OLLAMA_TIMEOUT=1.0


# ==========================================
# 5. VOICE PIPELINE
# ==========================================

# Speech-to-text mode: GOOGLE, GEMINI, or HYBRID (Google first, Gemini
# fallback). default: GOOGLE
# FRIDAY_AUDIO_MODE=GOOGLE

# Text-to-speech provider override (e.g. local, fish). Overrides the value
# stored in settings. Leave unset to use the in-app setting.
# FRIDAY_VOICE_PROVIDER=local

# Legacy alias for FRIDAY_VOICE_PROVIDER, checked only if it is unset.
# FRIDAY_VOICE_MODE=local

# Set to 0 to disable the Electron live-voice layer and use the Python audio
# engine instead. default: 1
# FRIDAY_LIVE_VOICE=1

# macOS system voice name for local speech (e.g. Moira, Samantha). Unset uses
# the built-in preference order.
# FRIDAY_TTS_VOICE=Moira

# Orb-animation timing offset, in seconds, for local playback. default: 0.20
# FRIDAY_LOCAL_PLAYBACK_OFFSET=0.20

# Orb-animation timing offset, in seconds, for afplay playback. default: 0.30
# FRIDAY_AFPLAY_PLAYBACK_OFFSET=0.30

# Microphone gain multiplier (0 < value <= 1) applied while FRIDAY speaks, to
# duck the mic in the Electron voice layer. default: 1 (no ducking)
# FRIDAY_MIC_DUCK=1


# ==========================================
# 6. MICROPHONE CAPTURE & FILTERING
# ==========================================

# PyAudio input device index. Unset lets the system pick the default device.
# FRIDAY_MIC_DEVICE_INDEX=0

# Capture sample rate in Hz. default: 16000
# FRIDAY_MIC_SAMPLE_RATE=16000

# Capture chunk size in frames. default: 512
# FRIDAY_MIC_CHUNK_SIZE=512

# Seconds of speech required before audio counts as a phrase. default: 0.2
# FRIDAY_MIC_PHRASE_THRESHOLD=0.2

# Seconds allowed for ambient-noise calibration at startup. default: 8
# FRIDAY_MIC_CALIBRATION_TIMEOUT=8

# Lower bound on the calibrated speech-trigger threshold. default: 16
# FRIDAY_MIC_ENERGY_FLOOR=16

# Upper bound on the calibrated speech-trigger threshold. default: 2200
# FRIDAY_MIC_ENERGY_CEILING=2200

# Cap above which a calibrated threshold is treated as having measured noise
# rather than the room. default: 320
# FRIDAY_MIC_TRIGGER_CAP=320

# Multiple of the measured noise floor that speech must exceed. default: 3.2
# FRIDAY_MIC_AMBIENT_RATIO=3.2

# Additive margin above the noise floor, so a silent room is not twitchy.
# default: 14
# FRIDAY_MIC_AMBIENT_MARGIN=14

# Seconds of dynamic ambient re-adjustment during listening. default: 0.6
# FRIDAY_MIC_AMBIENT_ADJUST=0.6

# Post-capture RMS floor; quieter audio is discarded before transcription.
# default: 12
# FRIDAY_MIN_AUDIO_RMS=12

# Fraction of the trigger threshold that mean phrase RMS must reach.
# default: 0.55
# FRIDAY_PHRASE_ENERGY_RATIO=0.55

# Minimum characters a transcript needs to be treated as a command. default: 2
# FRIDAY_MIN_COMMAND_CHARS=2

# Minimum recognizer confidence for a short transcript to be accepted.
# default: 0.45
# FRIDAY_MIN_TRANSCRIPT_CONFIDENCE=0.45


# ==========================================
# 7. VISION & PRESENCE (FACE ID)
# ==========================================

# Set to 1 to enable face-ID presence recognition. Requires the optional
# `deepface` dependency. default: 0 (disabled)
# FRIDAY_FACE_ID_ENABLED=0

# OpenCV camera device index. default: 0
# FRIDAY_CAMERA_INDEX=0

# Seconds between presence scans. default: 3.5
# FRIDAY_VISION_SCAN_INTERVAL=3.5

# Face-match distance threshold; lower is stricter. default: 0.50
# FRIDAY_FACE_MATCH_THRESHOLD=0.50

# Consecutive unknown-face scans before presence flips to unknown. default: 3
# FRIDAY_UNKNOWN_CONSECUTIVE_SCANS=3

# Consecutive matching scans before presence flips to authorized. default: 1
# FRIDAY_AUTHORIZED_CONSECUTIVE_SCANS=1

# Grace period, in seconds, before an unknown face is acted on. default: 10.0
# FRIDAY_UNKNOWN_GRACE_SECONDS=10.0

# Seconds an authorized presence is held after the face leaves frame.
# default: 180.0
# FRIDAY_AUTHORIZED_HOLD_SECONDS=180.0

# Seconds before an empty room is declared vacant. default: 120.0
# FRIDAY_VACANT_HOLD_SECONDS=120.0

# Frame-brightness level below which the room counts as too dark to scan.
# default: 42.0
# FRIDAY_LOW_LIGHT_THRESHOLD=42.0

# Seconds after a successful authorization during which unknown-face events are
# suppressed. default: 45.0
# FRIDAY_RECENT_AUTH_UNKNOWN_SUPPRESSION_SECONDS=45.0

# Set to 1 for verbose vision-pipeline logging. default: 0
# FRIDAY_VISION_DEBUG=0


# ==========================================
# 8. PROACTIVE BEHAVIOR
# ==========================================

# Set to 1 to let FRIDAY greet you unprompted on presence detection.
# default: 0
# FRIDAY_PROACTIVE_GREETING=0

# Minimum seconds between proactive messages. default: 7200 (2 hours)
# FRIDAY_PROACTIVE_COOLDOWN_SECONDS=7200


# ==========================================
# 9. PATHS, LOGGING & DEBUG
# ==========================================

# Override the memory store directory. default: FRIDAY_OS/Data/memory
# Used by the test suite to redirect memory to a temporary directory.
# FRIDAY_MEMORY_DIR=/absolute/path/to/memory/directory

# Override the Electron HUD directory. default: FRIDAY_OS/Visual_Interface
# FRIDAY_VISUAL_INTERFACE_DIR=/absolute/path/to/Visual_Interface

# Set to 0 to silence per-step performance timing logs. default: 1
# FRIDAY_PERF_LOG=1

# Set to 1 for verbose calendar-tool debug output. default: off
# FRIDAY_DEBUG=0


# ==========================================
# NOTE: GOOGLE CALENDAR CREDENTIALS
# ==========================================
# Calendar access does not use environment variables. It reads two files that
# are gitignored and not shipped with this repository:
#
#   FRIDAY_OS/Core_Cognition/calendar_credentials.json  (your OAuth client)
#   calendar_token.json                                 (generated on first auth)
#
# Supply your own OAuth client file, then run ./reconnect_calendar.sh to
# generate the token. Calendar features stay disabled without them.
